# Copy to .env and fill in. Never commit .env.

# Adapter modes: run everything on fakes first, switch one at a time.
MESSENGER_MODE=fake          # fake | linq
STT_MODE=fake                # fake | scribe
CALLS_MODE=fake              # fake | livekit
MEMORY_MODE=qdrant           # qdrant | fake

ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-sonnet-5-5
CALL_LLM_MODEL=claude-haiku-4-5
DEMO_USER_NAME=Sina                  # identity a never-seen user is seeded with
DEMO_BUSINESS_NAME=Trattoria da Demo # name of the seeded "usual Italian place"
CALL_LANGUAGE=en                     # en | de: language the call agent speaks by default

QDRANT_URL=                  # empty = embedded local Qdrant; docker compose sets http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PATH=                 # optional local disk path for embedded Qdrant (empty = in-memory)

LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=

DEEPSEEK_API_KEY=            # orchestrator search_restaurants (DeepSeek Search API)

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DE=
RESON8_API_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
CALL_AGENT_NAME=jamie-call-agent   # LiveKit agent_name: server dispatches to it, call_agent registers it

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
SMS_MODE=fake                # fake | twilio: how dashboard login codes are sent (fake logs them)
TWILIO_SMS_FROM=             # SMS-capable sender; empty = TWILIO_NUMBER
TWILIO_MESSAGING_SERVICE_SID=   # optional, used instead of TWILIO_SMS_FROM when set
AUTH_SECRET=                 # long random string, signs dashboard sessions (openssl rand -hex 32)
APP_DOMAIN=jamie-agentic-hack.app   # host serving the PWA; lets phones autofill the SMS code (empty = plain SMS)

SERVER_PUBLIC_URL=           # ngrok URL, used for Linq webhooks and by the call agent for events
LOCAL_SERVER_URL=http://127.0.0.1:8000   # where the fake call posts its events
ALLOWED_CALL_NUMBERS=        # comma-separated E.164 list; calls to anything else are refused

DATABASE_URL=                # empty = no database; docker compose sets it to its own Postgres
DISCLOSE_AI=false            # call agent: true = introduce itself as a digital assistant

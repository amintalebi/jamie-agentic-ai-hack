# Rendered to /etc/nginx/conf.d/default.conf; ${API_URL} is filled in from the environment.

# Hashed build files never change: cache for a year. Everything else must revalidate,
# so a deploy (new index.html, new sw.js) reaches users on their next load.
map $uri $cache_control {
    ~^/app/assets/  "public, max-age=31536000, immutable";
    default         "no-cache";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip_static on;                      # serve the precompressed .gz files
    gzip on;                             # and compress API responses on the fly
    gzip_types application/json text/plain;
    gzip_min_length 1024;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;   # the token can travel in the URL fragment

    location = /healthz { access_log off; return 200 "ok\n"; }
    location = / { return 302 /app/; }
    location = /app { return 301 /app/; }

    location = /app/manifest.webmanifest {
        types { application/manifest+json webmanifest; }
    }

    location /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
    }

    location / { return 404; }
}
